# Porta do servidor HTTP (Backend + Frontend unificado em produção)
PORT=3000

# Caminho do banco SQLite local (node:sqlite nativo do Node.js 22)
SQLITE_DB_PATH=./data/comparativo_llms.db

# Caminho do snapshot JSON estruturado exportado a cada sincronização
JSON_SNAPSHOT_PATH=./data/latest-snapshot.json

# Intervalo do agendador determinístico (em milissegundos - padrão: 300000 = 5 minutos)
SYNC_INTERVAL_MS=300000

# Timeout por requisição HTTP nos adaptadores (em milissegundos)
HTTP_TIMEOUT_MS=12000

# Chave opcional da API Artificial Analysis v2 (https://data.artificialanalysis.ai/api/v2/language/models)
# Quando não informada, o adaptador extrai deterministicamente os dados públicos de https://artificialanalysis.ai/leaderboards/models
AA_API_KEY=

# Token opcional do GitHub para elevar o rate-limit em chamadas à API pública do GitHub
GITHUB_TOKEN=